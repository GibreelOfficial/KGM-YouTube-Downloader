/* ==========================================================================
   1. Frameless Main Window & Shell Containers
   ========================================================================== */
#windowContainer, QWidget#FramelessWindow {
    background-color: {{primary_bg}};
    border: 2px solid {{border_color}};
    border-radius: 10px;
}

#sidebar {
    background-color: {{secondary_bg}};
    border-right: 2px solid {{border_color}};
}

#infoPanel {
    background-color: rgba(255, 255, 255, 0.02);
    border-top: 2px solid {{border_color}};
    border-radius: 12px;
}

/* ==========================================================================
   2. Custom Title Bar & Window Action Controls
   ========================================================================== */
#CustomTitleBar {
    border-bottom: 2px solid {{border_color}};
    color: {{text_main}};
    font-weight: normal;
    font-size: 13px;
}

#minBtn, #maxBtn, #closeBtn {
    background: transparent;
    color: {{text_main}};
    border: none;
    font-size: 16px;
    min-width: 18px;
    max-width: 18px;
    min-height: 18px;
    max-height: 18px;
    border-radius: 6px; 
}

#closeBtn:hover {
    background-color: {{danger}};
}

#minBtn:hover {
    background-color: {{ready}};
}

#maxBtn:hover {
    background-color: {{gogo}};
}

/* ==========================================================================
   3. Inputs & Standard Buttons Panel
   ========================================================================== */
QLineEdit#urlInput {
    background-color: {{secondary_bg}};
    border: 1px solid {{border_color}};
    border-radius: 5px;
    color: {{text_main}};
    padding-left: 12px;
    font-size: 13px;
}

QPushButton#fetchUrlBtn, QPushButton#queueWindowBtn {
    background-color: transparent;
    border: 2px solid {{border_color}};
    border-radius: 6px;
    color: {{text_main}};
    font-weight: bold;
}

QPushButton#fetchUrlBtn:hover, QPushButton#queueWindowBtn:hover {
    background-color: rgba(255, 255, 255, 0.05);
}

QPushButton#browseBtn {
    background-color: transparent;
    border: 2px solid {{border_color}};
    border-radius: 6px;
    color: {{text_main}};
    padding-left: 12px;
    padding-right: 12px;
    font-size: 12px;
}

QPushButton#browseBtn:hover {
    background-color: rgba(255, 255, 255, 0.05);
}

#addUrlBtn {
    background-color: transparent;
    border: 2px dashed {{border_color}};
    border-radius: 15px;
    color: {{text_main}};
    font-size: 20px;
}

#addUrlBtn:hover {
    border-color: {{accent_color}};
    background-color: rgba(0, 255, 204, 0.05);
}

#destLabel {
    color: {{text_main}};
    font-weight: bold;
}

#detailName{
    color:{{text_main}}
}

#detailPathDisplay {
    color: {{text_main}};
}

/* ==========================================================================
   4. Custom Media Data Table View
   ========================================================================== */
#customTable {
    background-color: {{primary_bg}};
    alternate-background-color: {{primary_bg}};
    selection-background-color: {{secondary_bg}};
    selection-color: {{text_main}};
    outline: none;
    border: none;
    color: {{text_main}};
}

#customTable::item {
    padding: 3px;
}

#customTable::item:selected {
    background-color: {{secondary_bg}};
    border: 2px solid {{ready}};
}

QHeaderView::section {
    background-color: {{primary_bg}};
    color: {{text_main}};
    padding-left: 15px;
    border: 1px solid {{border_color}};
    font-weight: 300;
    font-size: 12px;
}

/* ==========================================================================
   5. System Progress Bars & Custom Scrollbars
   ========================================================================== */
QProgressBar {
    border: 1px solid {{border_color}};
    border-radius: 5px;
    background: {{secondary_bg}};
    text-align: right;
    margin-right: 40px;
}

QProgressBar::chunk {
    border-radius: 4px;
}

QProgressBar[statusClass="complete"]::chunk { background-color: #8bc34a; }
QProgressBar[statusClass="paused"]::chunk   { background-color: #ff9800; }
QProgressBar[statusClass="failed"]::chunk   { background-color: #f44336; }
QProgressBar[statusClass="queued"]::chunk   { background-color: #03a9f4; }

QScrollBar:vertical {
    border: none;
    background: transparent;
    width: 6px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background: {{border_color}};
    min-height: 20px;
    border-radius: 3px;
}

/* ==========================================================================
   6. System Status Bar Layouts
   ========================================================================== */
#statusBar {
    border-top: 2px solid {{border_color}};
    color: {{text_main}};
}

#statusBar QLabel {
    color: {{text_main}};
    font-size: 12px;
}

QPushButton#statusBarUpdateBtn, QPushButton#statusBarAboutBtn {
    background-color: transparent;
    border: none;
    color: {{text_main}};
    font-size: 12px;
    padding-left: 8px;
    padding-right: 8px;
}

QPushButton#statusBarUpdateBtn:hover, QPushButton#statusBarAboutBtn:hover {
    color: {{accent_color}};
    background-color: rgba(255, 255, 255, 0.03);
    border-radius: 4px;
}

/* ==========================================================================
   7. About Component Interface Profile
   ========================================================================== */
QLabel#aboutTitle {
    color: {{text_main}};
    font-size: 18px;
    font-weight: bold;
}

QLabel#aboutVersion {
    color: {{text_muted}};
    font-size: 13px;
}

#aboutCredits {
    color: {{text_main}};
    font-size: 12px;
    line-height: 18px;
}

QWidget#supportContainer {
    background-color: {{secondary_bg}};
    border: 1px solid {{border_color}};
    border-radius: 6px;
}

QLabel#supportTitle {
    color: {{text_main}};
    font-size: 12px;
    font-weight: bold;
}

QLabel#momoLabel {
    color: {{text_main}};
    font-size: 12px;
}

QPushButton#kofiSupportBtn {
    background-color: transparent;
    border: 1px solid #03a9f4;
    border-radius: 4px;
    color: #03a9f4;
    font-weight: bold;
    font-size: 12px;
    padding: 4px;
}

QPushButton#kofiSupportBtn:hover {
    background-color: rgba(3, 169, 244, 0.1);
}

QPushButton#kofiSupportBtn:pressed {
    background-color: rgba(3, 169, 244, 0.2);
}

QPushButton#aboutCloseBtn {
    background-color: {{secondary_bg}};
    border: 1px solid {{border_color}};
    border-radius: 4px;
    color: {{text_main}};
    font-weight: bold;
    font-size: 12px;
}

QPushButton#aboutCloseBtn:hover {
    background-color: rgba(255, 255, 255, 0.04);
    border-color: {{accent_color}};
}

QPushButton#aboutCloseBtn:pressed {
    background-color: {{primary_bg}};
}